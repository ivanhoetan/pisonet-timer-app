{
  "name": "@pisonet/windows-client",
  "version": "1.0.0",
  "description": "Pisonet account-based timer kiosk client for Windows",
  "author": "ivanhoeytan-mysuki",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@pisonet/shared": "*",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "electron": "34.3.0",
    "electron-builder": "25.1.8",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vue": "^3.5.13",
    "wait-on": "^8.0.3",
    "vue-tsc": "^2.2.8"
  },
  "build": {
    "appId": "com.pisonet.timer",
    "productName": "Pisonet Timer",
    "electronVersion": "34.3.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
